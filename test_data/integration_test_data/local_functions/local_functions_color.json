{
  "description": "Local functions with color arguments.",
  "div_data": {
    "card": {
      "log_id": "local_functions",
      "variables": [
        {
          "name": "color_var",
          "type": "color",
          "value": "#AABBCC"
        },
        {
          "name": "step",
          "type": "integer",
          "value": -1
        }
      ],
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "text",
            "text": "text",
            "functions": [
              {
                "name": "colorFunction",
                "body": "@{color}",
                "return_type": "color",
                "arguments": [
                  {
                    "name": "color",
                    "type": "color"
                  }
                ]
              }
            ],
            "variable_triggers": [
              {
                "condition": "@{step == 0}",
                "actions": [
                  {
                    "log_id": "step 0",
                    "url": "div-action://set_variable?name=result&value=@{colorFunction(color_var)}"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "steps": [
    {
      "type": "div_action",
      "action": {
        "log_id": "check colorFunction",
        "url": "div-action://set_variable?name=step&value=0"
      }
    },
    {
      "type": "verify_variable",
      "variable_name": "result",
      "value": {
        "type": "color",
        "value": "#FFAABBCC"
      }
    }
  ],
  "platforms": [
    "android",
    "ios",
    "web"
  ]
}
