{
  "description": "Local triggers",
  "div_data": {
    "card": {
      "log_id": "sample_card",
      "variables": [
        {
          "name": "counter",
          "type": "integer",
          "value": 0
        },
        {
          "name": "trigger_state",
          "type": "string",
          "value": "unset"
        }
      ],
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "container",
            "orientation": "vertical",
            "items": [
              {
                "type": "text",
                "text": "Total count: @{counter}",
                "variable_triggers": [
                  {
                    "condition": "@{counter > 100}",
                    "actions": [
                      {
                        "log_id": "trigger_invoke",
                        "url": "div-action://set_variable?name=trigger_state&value=activated"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "cases": [
    {
      "steps": [
        {
          "type": "verify_variable",
          "variable_name": "trigger_state",
          "value": {
            "type": "string",
            "value": "unset"
          }
        }
      ],
      "platforms": [
        "android",
        "ios",
        "web"
      ]
    },
    {
      "steps": [
        {
          "type": "div_action",
          "action": {
            "url": "div-action://set_variable?name=counter&value=50",
            "log_id": "set_50"
          }
        },
        {
          "type": "verify_variable",
          "variable_name": "trigger_state",
          "value": {
            "type": "string",
            "value": "unset"
          }
        }
      ],
      "platforms": [
        "android",
        "ios",
        "web"
      ]
    },
    {
      "steps": [
        {
          "type": "div_action",
          "action": {
            "url": "div-action://set_variable?name=counter&value=110",
            "log_id": "set_110"
          }
        },
        {
          "type": "verify_variable",
          "variable_name": "trigger_state",
          "value": {
            "type": "string",
            "value": "activated"
          }
        }
      ],
      "platforms": [
        "android",
        "ios",
        "web"
      ]
    }
  ]
}
