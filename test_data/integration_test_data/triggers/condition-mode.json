{
  "description": "Triggers with mode 'on_condition': condition transitions and all four combinations of two boolean variables.",
  "div_data": {
    "card": {
      "log_id": "sample_card",
      "variables": [
        {
          "name": "total_likes",
          "type": "integer",
          "value": 0
        },
        {
          "name": "trigger_state",
          "type": "string",
          "value": "unset"
        },
        {
          "name": "left_switched",
          "type": "boolean",
          "value": 0
        },
        {
          "name": "right_switched",
          "type": "boolean",
          "value": 0
        },
        {
          "name": "combined_trigger_state",
          "type": "string",
          "value": "unset"
        }
      ],
      "variable_triggers": [
        {
          "condition": "@{total_likes > 100}",
          "mode": "on_condition",
          "actions": [
            {
              "log_id": "trigger_invoke",
              "url": "div-action://set_variable?name=trigger_state&value=activated"
            }
          ]
        },
        {
          "condition": "@{left_switched && !right_switched}",
          "mode": "on_condition",
          "actions": [
            {
              "log_id": "set_left_trigger_state",
              "url": "div-action://set_variable?name=combined_trigger_state&value=Left%20switched"
            }
          ]
        },
        {
          "condition": "@{!left_switched && right_switched}",
          "mode": "on_condition",
          "actions": [
            {
              "log_id": "set_right_trigger_state",
              "url": "div-action://set_variable?name=combined_trigger_state&value=Right%20switched"
            }
          ]
        },
        {
          "condition": "@{left_switched && right_switched}",
          "mode": "on_condition",
          "actions": [
            {
              "log_id": "set_both_trigger_state",
              "url": "div-action://set_variable?name=combined_trigger_state&value=Both%20switched"
            }
          ]
        },
        {
          "condition": "@{!left_switched && !right_switched}",
          "mode": "on_condition",
          "actions": [
            {
              "log_id": "set_neither_trigger_state",
              "url": "div-action://set_variable?name=combined_trigger_state&value=No%20buttons%20switched"
            }
          ]
        }
      ],
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "text",
            "text": "text"
          }
        }
      ]
    }
  },
