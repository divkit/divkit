{
  "description": "Check subscription for getUrlValue with url fallback.",
  "div_data": {
    "card": {
      "log_id": "get_url_value_with_url_fallback",
      "variables": [
        {
          "name": "part_of_name",
          "type": "string",
          "value": "1"
        },
        {
          "name": "var_1",
          "type": "url",
          "value": "url1://initial"
        },
        {
          "name": "var_2",
          "type": "url",
          "value": "url2://initial"
        },
        {
          "name": "fallback",
          "type": "url",
          "value": "empty://"
        }
      ],
      "variable_triggers": [
        {
          "condition": "@{getUrlValue('var_' + part_of_name, fallback) != fallback}",
          "mode": "on_variable",
          "actions": [
            {
              "log_id": "check result",
              "typed": {
                "type": "set_variable",
                "variable_name": "result",
                "value": {
                  "type": "url",
                  "value": "@{getUrlValue('var_' + part_of_name, fallback)}"
                }
              }
            }
          ]
        }
      ],
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "text",
            "text": "text"
          }
        }
      ]
    }
  },
