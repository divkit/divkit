{
  "description": "show_tooltip / hide_tooltip. scope_id-related cases. Tooltip id is duplicated across 3 item_builder items.",
  "div_data": {
    "card": {
      "log_id": "test",
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "container",
            "item_builder": {
              "data": [
                {
                  "i": 1
                },
                {
                  "i": 2
                },
                {
                  "i": 3
                }
              ],
              "prototypes": [
                {
                  "id": "item_@{getIntegerFromDict(it, 'i')}",
                  "div": {
                    "type": "text",
                    "text": "anchor @{getIntegerFromDict(it, 'i')}",
                    "tooltips": [
                      {
                        "id": "inner_tooltip",
                        "position": "bottom",
                        "duration": 0,
                        "div": {
                          "type": "text",
                          "text": "tip"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "cases": [
    {
      "steps": [
        {
          "type": "div_action",
          "action": {
            "log_id": "show_tooltip_no_scope_duplicate",
            "typed": {
              "type": "show_tooltip",
              "id": "inner_tooltip",
              "multiple": true
            }
          }
        },
        {
          "type": "verify_errors",
          "errors": [
            "Tooltip with id 'inner_tooltip' is ambiguous"
          ]
        }
      ],
      "platforms": [
        "ios",
        "web"
      ]
    },
    {
      "steps": [
        {
          "type": "div_action",
          "action": {
            "log_id": "show_tooltip_scope_not_found",
            "scope_id": "nonexistent_scope",
            "typed": {
              "type": "show_tooltip",
              "id": "inner_tooltip",
              "multiple": false
            }
          }
        },
        {
          "type": "verify_errors",
          "errors": [
            "Scope with id 'nonexistent_scope' not found",
            "Tooltip with id 'inner_tooltip' is ambiguous"
          ]
        }
      ],
      "platforms": [
        "ios",
        "web"
      ]
    },
    {
      "steps": [
        {
          "type": "div_action",
          "action": {
            "log_id": "hide_tooltip_scope_not_found",
            "scope_id": "nonexistent_scope",
            "typed": {
              "type": "hide_tooltip",
              "id": "inner_tooltip"
            }
          }
        },
        {
          "type": "verify_errors",
          "errors": [
            "Scope with id 'nonexistent_scope' not found"
          ]
        }
      ],
      "platforms": [
        "ios",
        "web"
      ]
    }
  ]
}
