{
  "description": "",
  "platforms": [
    "android",
    "ios",
    "web"
  ],
  "div_data": {
    "templates": {
      "item_text": {
        "type": "text",
        "font_size": 32,
        "text_alignment_horizontal": "center",
        "text_alignment_vertical": "center",
        "width": {
          "type": "fixed",
          "value": 200
        },
        "height": {
          "type": "fixed",
          "value": 200
        }
      },
      "pager_block": {
        "type": "pager",
        "id": "pager",
        "layout_mode": {
          "type": "wrap_content"
        },
        "width": {
          "type": "match_parent"
        }
      },
      "indicator_block": {
        "type": "indicator",
        "pager_id": "pager",
        "active_shape": {
          "type": "rounded_rectangle",
          "background_color": "#21201F",
          "corner_radius": {
            "type": "fixed",
            "value": 16
          },
          "item_height": {
            "type": "fixed",
            "value": 16
          },
          "item_width": {
            "type": "fixed",
            "value": 16
          },
          "stroke": {
            "color": "#FFFFFF",
            "unit": "px",
            "width": 1
          }
        },
        "alignment_horizontal": "center",
        "alignment_vertical": "bottom",
        "height": {
          "type": "wrap_content"
        },
        "inactive_minimum_shape": {
          "type": "rounded_rectangle",
          "background_color": "#4d21201F",
          "corner_radius": {
            "type": "fixed",
            "value": 14
          },
          "item_height": {
            "type": "fixed",
            "value": 14
          },
          "item_width": {
            "type": "fixed",
            "value": 14
          },
          "stroke": {
            "color": "#FFFFFF",
            "unit": "px",
            "width": 1
          }
        },
        "inactive_shape": {
          "type": "rounded_rectangle",
          "background_color": "#4d21201F",
          "corner_radius": {
            "type": "fixed",
            "value": 14
          },
          "item_height": {
            "type": "fixed",
            "value": 14
          },
          "item_width": {
            "type": "fixed",
            "value": 14
          },
          "stroke": {
            "color": "#FFFFFF",
            "unit": "px",
            "width": 1
          }
        },
        "margins": {
          "bottom": 5,
          "right": 6
        },
        "space_between_centers": {
          "type": "fixed",
          "value": 18
        },
        "width": {
          "type": "wrap_content"
        }
      }
    },
    "card": {
      "log_id": "div2_sample_card",
      "variables": [
        {
          "name": "count",
          "type": "integer",
          "value": 0
        },
        {
          "name": "is_visible",
          "type": "boolean",
          "value": true
        }
      ],
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "container",
            "orientation": "vertical",
            "width": {
              "type": "match_parent"
            },
            "height": {
              "type": "match_parent"
            },
            "content_alignment_horizontal": "center",
            "items": [
              {
                "type": "container",
                "width": {
                  "type": "match_parent"
                },
                "height": {
                  "type": "match_parent"
                },
                "content_alignment_horizontal": "center",
                "items": [
                  {
                    "type": "pager_block",
                    "item_count_variable": "count",
                    "item_builder": {
                      "type": "prototype",
                      "data": [
                        {
                          "text": "Item A"
                        },
                        {
                          "text": "Item B"
                        },
                        {
                          "text": "Item C"
                        }
                      ],
                      "prototypes": [
                        {
                          "div": {
                            "type": "item_text",
                            "text": "@{it.getString('text')}",
                            "visibility": "@{(is_visible || index != 0) ? 'visible' : 'gone'}"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "indicator_block"
                  },
                  {
                    "type": "text",
                    "text": "Item count: @{count}",
                    "font_size": 32
                  },
                  {
                    "type": "text",
                    "text": "Toggle item",
                    "font_size": 32,
                    "background": [
                      {
                        "type": "solid",
                        "color": "#dba1d4"
                      }
                    ],
                    "paddings": {
                      "top": 10,
                      "bottom": 10,
                      "left": 20,
                      "right": 20
                    },
                    "border": {
                      "corner_radius": 6
                    },
                    "action": {
                      "log_id": "toggle",
                      "url": "div-action://set_variable?name=is_visible&value=@{is_visible ? 'false' : 'true'}"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "steps": [
    {
      "type": "verify_snapshot",
      "name": "step0"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://set_variable?name=is_visible&value=false",
        "log_id": "hide item"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "step1"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://set_variable?name=is_visible&value=true",
        "log_id": "show item"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "step2"
    }
  ]
}
