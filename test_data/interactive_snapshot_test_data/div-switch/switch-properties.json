{
  "description": "Switch properties",
  "platforms": [
    "ios",
    "android",
    "web"
  ],
  "div_data": {
    "card": {
      "log_id": "tests",
      "variables": [
        {
          "name": "switch_value",
          "type": "boolean",
          "value": false
        },
        {
          "name": "on_color_var",
          "type": "color",
          "value": "#FFFFFF"
        },
        {
          "name": "switch_enabled",
          "type": "boolean",
          "value": true
        }
      ],
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "switch",
            "is_on_variable": "switch_value",
            "is_enabled": "@{switch_enabled}",
            "on_color": "@{on_color_var}"
          }
        }
      ]
    }
  },
  "steps": [
    {
      "type": "verify_snapshot",
      "name": "step0"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://set_variable?name=switch_value&value=true",
        "log_id": "switch_value"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "step1"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://set_variable?name=on_color_var&value=%232a35ad",
        "log_id": "change_color"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "step2"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://set_variable?name=switch_enabled&value=false",
        "log_id": "disable_switch"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "step3"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://set_variable?name=switch_value&value=false",
        "log_id": "disabled_switch_off"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "step4"
    }
  ]
}
