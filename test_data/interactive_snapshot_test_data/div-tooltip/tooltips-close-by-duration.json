{
  "description": "#117 Tooltips: restore the original non-animated tooltip and close it through duration=1500 ms. Verify the tooltip snapshot and visibility log, wait for the original disappear action to change its status text, then verify the disappear log, visibility status and the card after disappearance. No hide_tooltip action is used to close this tooltip. Tapping outside is not covered; its necessity is pending discussion. Animation progress is not verified. All snapshots capture the page without an element target.",
  "platforms": [
    "ios"
  ],
  "div_data": {
    "templates": {
      "button": {
        "type": "text",
        "paddings": {
          "left": 16,
          "top": 16,
          "right": 16,
          "bottom": 16
        },
        "margins": {
          "top": 16,
          "left": 12,
          "right": 12,
          "bottom": 96
        },
        "border": {
          "corner_radius": 8
        },
        "background": [
          {
            "type": "solid",
            "color": "#0E000000"
          }
        ],
        "font_size": 16,
        "font_weight": "medium",
        "text_alignment_vertical": "center",
        "text_alignment_horizontal": "center",
        "text_color": "#000000",
        "alpha": 1,
        "alignment_horizontal": "center",
        "alignment_vertical": "center",
        "height": {
          "type": "fixed",
          "value": 96
        }
      }
    },
    "card": {
      "log_id": "visibility",
      "variables": [
        {
          "type": "string",
          "name": "visibility_called",
          "value": "false"
        },
        {
          "type": "string",
          "name": "disappear_called",
          "value": "false"
        }
      ],
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "container",
            "items": [
              {
                "type": "button",
                "text": "Tooltip closed by duration (1500 ms)",
                "tooltips": [
                  {
                    "id": "non_animated_tooltip_with_visibility",
                    "position": "bottom",
                    "duration": 1500,
                    "offset": {
                      "x": {
                        "value": 0
                      },
                      "y": {
                        "value": 4
                      }
                    },
                    "animation_in": {
                      "name": "no_animation"
                    },
                    "animation_out": {
                      "name": "no_animation"
                    },
                    "div": {
                      "type": "container",
                      "width": {
                        "type": "wrap_content"
                      },
                      "items": [
                        {
                          "type": "text",
                          "width": {
                            "type": "wrap_content"
                          },
                          "paddings": {
                            "left": 16,
                            "top": 16,
                            "right": 16,
                            "bottom": 16
                          },
                          "background": [
                            {
                              "type": "solid",
                              "color": "#799eb7"
                            }
                          ],
                          "border": {
                            "corner_radius": 6
                          },
                          "font_size": 18,
                          "text_color": "#2C3E50",
                          "text": "Title tooltip"
                        }
                      ],
                      "visibility_actions": [
                        {
                          "log_id": "duration_tooltip_visible",
                          "url": "div-action://set_variable?name=visibility_called&value=true",
                          "log_limit": 0,
                          "visibility_duration": 0,
                          "visibility_percentage": 100
                        }
                      ],
                      "disappear_actions": [
                        {
                          "log_id": "duration_tooltip_disappeared",
                          "log_limit": 0,
                          "disappear_duration": 0,
                          "visibility_percentage": 20,
                          "url": "div-action://set_variable?name=disappear_called&value=true"
                        }
                      ],
                      "paddings": {
                        "left": 16,
                        "top": 16,
                        "right": 16,
                        "bottom": 16
                      }
                    }
                  }
                ],
                "actions": [
                  {
                    "log_id": "show_duration_tooltip",
                    "url": "div-action://show_tooltip?id=non_animated_tooltip_with_visibility&multiple=true"
                  }
                ],
                "id": "show_tooltip_with_duration"
              },
              {
                "type": "text",
                "text": "Visibility action called: @{visibility_called}",
                "id": "visibility_action_status"
              },
              {
                "type": "text",
                "text": "Disappear action called: @{disappear_called}",
                "id": "disappear_action_status"
              }
            ]
          }
        }
      ]
    }
  },
  "steps": [
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "visibility_action_status"
      },
      "text": "Visibility action called: false"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "disappear_action_status"
      },
      "text": "Disappear action called: false"
    },
    {
      "type": "tap",
      "target": {
        "type": "div_id",
        "id": "show_tooltip_with_duration"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "close_by_duration_tooltip"
    },
    {
      "type": "verify_log",
      "source": "visibility",
      "id": "duration_tooltip_visible",
      "count": 1
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "disappear_action_status"
      },
      "text": "Disappear action called: true"
    },
    {
      "type": "verify_log",
      "source": "disappear",
      "id": "duration_tooltip_disappeared",
      "count": 1
    },
    {
      "type": "verify_snapshot",
      "name": "disappeared"
    }
  ]
}
