{
  "description": "set_variable resolves the nearest declaration of the same name in card, element-local and parent-local scopes; tapping each row updates its value while the other two remain unchanged.",
  "platforms": [
    "android",
    "ios"
  ],
  "div_data": {
    "templates": {
      "item": {
        "type": "text",
        "font_size": 16,
        "paddings": {
          "left": 20,
          "right": 20,
          "top": 10,
          "bottom": 10
        },
        "action": {
          "log_id": "update_variable",
          "url": "div-action://set_variable?name=string_var&value=new value"
        }
      }
    },
    "card": {
      "log_id": "test_card",
      "variables": [
        {
          "name": "string_var",
          "type": "string",
          "value": "global value"
        }
      ],
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "container",
            "margins": {
              "top": 10,
              "bottom": 10
            },
            "items": [
              {
                "type": "item",
                "text": "global string_var = '@{string_var}'",
                "id": "global_variable_text",
                "action": {
                  "log_id": "update_variable",
                  "url": "div-action://set_variable?name=string_var&value=new global value"
                }
              },
              {
                "type": "item",
                "text": "local string_var = '@{string_var}'",
                "variables": [
                  {
                    "name": "string_var",
                    "type": "string",
                    "value": "local value"
                  }
                ],
                "id": "local_variable_text",
                "action": {
                  "log_id": "update_variable",
                  "url": "div-action://set_variable?name=string_var&value=new local value"
                }
              },
              {
                "type": "container",
                "variables": [
                  {
                    "name": "string_var",
                    "type": "string",
                    "value": "local value"
                  }
                ],
                "items": [
                  {
                    "type": "item",
                    "text": "parent local string_var = '@{string_var}'",
                    "id": "parent_local_variable_text",
                    "action": {
                      "log_id": "update_variable",
                      "url": "div-action://set_variable?name=string_var&value=new parent local value"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "steps": [
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "global_variable_text"
      },
      "text": "global string_var = 'global value'"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "local_variable_text"
      },
      "text": "local string_var = 'local value'"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "parent_local_variable_text"
      },
      "text": "parent local string_var = 'local value'"
    },
    {
      "type": "tap",
      "target": {
        "type": "div_id",
        "id": "global_variable_text"
      }
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "global_variable_text"
      },
      "text": "global string_var = 'new global value'"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "local_variable_text"
      },
      "text": "local string_var = 'local value'"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "parent_local_variable_text"
      },
      "text": "parent local string_var = 'local value'"
    },
    {
      "type": "tap",
      "target": {
        "type": "div_id",
        "id": "local_variable_text"
      }
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "global_variable_text"
      },
      "text": "global string_var = 'new global value'"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "local_variable_text"
      },
      "text": "local string_var = 'new local value'"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "parent_local_variable_text"
      },
      "text": "parent local string_var = 'local value'"
    },
    {
      "type": "tap",
      "target": {
        "type": "div_id",
        "id": "parent_local_variable_text"
      }
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "global_variable_text"
      },
      "text": "global string_var = 'new global value'"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "local_variable_text"
      },
      "text": "local string_var = 'new local value'"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "parent_local_variable_text"
      },
      "text": "parent local string_var = 'new parent local value'"
    }
  ]
}
