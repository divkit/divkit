{
  "description": "Change states using state_id_variable",
  "platforms": [
    "android",
    "ios",
    "web"
  ],
  "div_data": {
    "card": {
      "log_id": "test",
      "variables": [
        {
          "name": "state_id_var",
          "type": "string",
          "value": "state2"
        }
      ],
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "container",
            "items": [
              {
                "type": "text",
                "text": "Variable: @{state_id_var}"
              },
              {
                "type": "state",
                "id": "states",
                "state_id_variable": "state_id_var",
                "states": [
                  {
                    "state_id": "state1",
                    "div": {
                      "type": "text",
                      "text": "First State"
                    }
                  },
                  {
                    "state_id": "state2",
                    "div": {
                      "type": "text",
                      "text": "Second state"
                    }
                  },
                  {
                    "state_id": "state3",
                    "div": {
                      "type": "text",
                      "text": "Third state"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "steps": [
    {
      "type": "verify_snapshot",
      "name": "step0"
    },
    {
      "type": "div_action",
      "action": {
        "log_id": "state3",
        "url": "div-action://set_state?state_id=0/states/state3"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "step1"
    },
    {
      "type": "div_action",
      "action": {
        "log_id": "state2",
        "url": "div-action://set_variable?name=state_id_var&value=state2"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "step0"
    }
  ]
}
