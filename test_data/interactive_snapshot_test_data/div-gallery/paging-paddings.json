{
  "description": "Gallery with scroll_mode=paging and paddings",
  "platforms": [
    "android",
    "ios",
    "web"
  ],
  "div_data": {
    "templates": {
      "item": {
        "type": "text",
        "text": "",
        "height": {
          "type": "fixed",
          "value": 100
        },
        "border": {
          "corner_radius": 10
        }
      }
    },
    "card": {
      "log_id": "tests",
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "gallery",
            "id": "gallery",
            "orientation": "horizontal",
            "scroll_mode": "paging",
            "item_spacing": 10,
            "paddings": {
              "left": 20,
              "right": 40
            },
            "items": [
              {
                "type": "item",
                "background": [
                  {
                    "color": "#49a5a5",
                    "type": "solid"
                  }
                ]
              },
              {
                "type": "item",
                "background": [
                  {
                    "color": "#49a141",
                    "type": "solid"
                  }
                ]
              },
              {
                "type": "item",
                "background": [
                  {
                    "color": "#4975a5",
                    "type": "solid"
                  }
                ]
              },
              {
                "type": "item",
                "background": [
                  {
                    "color": "#11e5a5",
                    "type": "solid"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "steps": [
    {
      "type": "verify_snapshot",
      "name": "step0"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://set_next_item?id=gallery&animated=false",
        "log_id": "scroll_forward"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "step1"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://scroll_to_end?id=gallery&animated=false",
        "log_id": "scroll_to_end"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "step2"
    }
  ]
}
