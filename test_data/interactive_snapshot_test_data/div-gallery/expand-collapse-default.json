                "content_id": "content_4",
                "button_id": "button_4",
                "content_expand_action": "div-action://set_state?state_id=0/content_4/expanded",
                "content_collapse_action": "div-action://set_state?state_id=0/content_4/collapsed",
                "text_expand_action": "div-action://set_state?state_id=0/button_4/text_expand",
                "text_collapse_action": "div-action://set_state?state_id=0/button_4/text_collapse"
              },
              {
                "type": "gallery_item_content",
                "header_text": "Item 5",
                "item_text": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.",
                "content_id": "content_5",
                "button_id": "button_5",
                "content_expand_action": "div-action://set_state?state_id=0/content_5/expanded",
                "content_collapse_action": "div-action://set_state?state_id=0/content_5/collapsed",
                "text_expand_action": "div-action://set_state?state_id=0/button_5/text_expand",
                "text_collapse_action": "div-action://set_state?state_id=0/button_5/text_collapse"
              }
            ],
            "id": "gallery"
          }
        }
      ]
    },
    "templates": {
      "gallery_item_text": {
        "type": "text",
        "paddings": {
          "left": 16,
          "right": 16
        },
        "text_color": "#000000",
        "font_size": 16
      },
      "gallery_item_button": {
        "type": "text",
        "height": {
          "type": "fixed",
          "value": 36
        },
        "margins": {
          "left": 16,
          "right": 16,
          "bottom": 8
        },
        "background": [
          {
            "type": "solid",
            "color": "#f1dff2"
          }
        ],
        "border": {
          "corner_radius": 8
        },
        "font_size": 16,
        "font_weight": "medium",
        "max_lines": 1,
        "text_alignment_horizontal": "center",
        "text_alignment_vertical": "center",
        "text_color": "#000000"
      },
      "gallery_item_content": {
        "type": "container",
        "width": {
          "type": "fixed",
          "value": 320
        },
        "height": {
          "type": "wrap_content"
        },
        "border": {
          "corner_radius": 8
        },
        "margins": {
          "top": 8
        },
        "background": [
          {
            "type": "solid",
            "color": "#0e000000"
          }
        ],
        "items": [
          {
            "type": "text",
            "text_color": "#000000",
            "width": {
              "type": "match_parent"
            },
            "paddings": {
              "left": 16,
              "right": 16,
              "top": 8,
              "bottom": 8
            },
            "font_size": 18,
            "text_alignment_horizontal": "left",
            "$text": "header_text"
          },
          {
            "type": "state",
            "$id": "content_id",
            "states": [
              {
                "state_id": "collapsed",
                "animation_in": {
                  "name": "fade",
                  "interpolator": "ease",
                  "duration": 200
                },
                "animation_out": {
                  "name": "fade",
                  "interpolator": "ease_in_out",
                  "duration": 200
                },
                "div": {
                  "type": "gallery_item_text",
                  "margins": {
                    "bottom": 16
                  },
                  "max_lines": 5,
                  "$text": "item_text"
                }
              },
              {
                "state_id": "expanded",
                "animation_in": {
                  "name": "fade",
                  "interpolator": "ease",
                  "duration": 200
                },
                "animation_out": {
                  "name": "fade",
                  "interpolator": "ease_in_out",
                  "duration": 200
                },
                "div": {
                  "type": "gallery_item_text",
                  "margins": {
                    "bottom": 16
                  },
                  "$text": "item_text"
                }
              }
            ]
          },
          {
            "type": "state",
            "$id": "button_id",
            "states": [
              {
                "state_id": "text_expand",
                "div": {
                  "type": "gallery_item_button",
                  "text": "EXPAND",
                  "actions": [
                    {
                      "log_id": "expand_content",
                      "$url": "content_expand_action"
                    },
                    {
                      "log_id": "button_text_collapse",
                      "$url": "text_collapse_action"
                    }
                  ],
                  "$id": "button_label_id"
                }
              },
              {
                "state_id": "text_collapse",
                "div": {
                  "type": "gallery_item_button",
                  "text": "COLLAPSE",
                  "actions": [
                    {
                      "log_id": "collapse_content",
                      "$url": "content_collapse_action"
                    },
                    {
                      "log_id": "button_text_expand",
                      "$url": "text_expand_action"
                    }
                  ],
                  "$id": "button_label_id"
                }
              }
            ]
          }
        ]
      }
    }
  },
  "steps": [
    {
      "type": "verify_snapshot",
      "name": "initial"
    },
    {
      "type": "tap",
      "target": {
        "type": "div_id",
        "id": "item_2_expand_collapse_button"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "item_2_expanded"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://set_current_item?id=gallery&item=0&animated=false",
        "log_id": "show_item_0"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "item_0_after_scroll"
    },
    {
      "type": "tap",
      "target": {
        "type": "div_id",
        "id": "item_0_expand_collapse_button"
      }
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "item_0_expand_collapse_button_text"
      },
      "text": "COLLAPSE"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://set_current_item?id=gallery&item=1&animated=false",
        "log_id": "show_item_1"
      }
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "item_1_expand_collapse_button_text"
      },
      "text": "EXPAND"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://set_current_item?id=gallery&item=2&animated=false",
        "log_id": "show_item_2"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "item_2_expanded"
    },
    {
      "type": "tap",
      "target": {
        "type": "div_id",
        "id": "item_2_expand_collapse_button"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "item_2_collapsed"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://set_current_item?id=gallery&item=0&animated=false",
        "log_id": "return_to_item_0"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "item_0_after_collapse_item_2"
    }
  ]
}
