{
  "description": "In a gallery with scroll_mode default and default_item 2, EXPAND/COLLAPSE taps switch the content and button DivState of the tapped item. Text checks and whole-gallery snapshots verify that only the tapped gallery item changes state.",
  "platforms": [
    "android",
    "ios"
  ],
