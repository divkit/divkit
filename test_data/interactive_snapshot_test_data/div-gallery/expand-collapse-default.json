                "content_expand_action": "div-action://set_state?state_id=0/content_2/expanded",
                "content_collapse_action": "div-action://set_state?state_id=0/content_2/collapsed",
                "text_expand_action": "div-action://set_state?state_id=0/item_2_expand_collapse_button/text_expand",
                "text_collapse_action": "div-action://set_state?state_id=0/item_2_expand_collapse_button/text_collapse",
                "button_label_id": "item_2_expand_collapse_button_text"
              },
              {
