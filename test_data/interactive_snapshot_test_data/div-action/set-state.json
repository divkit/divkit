{
  "description": "A nested DivState initially displays its first state; div-action://set_state switches it to the second state and back, with the displayed text checked at each step.",
  "platforms": [
    "android",
    "ios",
    "web"
  ],
  "div_data": {
    "card": {
      "log_id": "sample_card",
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "state",
            "id": "sample",
            "states": [
              {
                "state_id": "first",
                "div": {
                  "type": "text",
                  "id": "state_text",
                  "text": "first state"
                }
              },
              {
                "state_id": "second",
                "div": {
                  "type": "text",
                  "id": "state_text",
                  "text": "second state"
                }
              }
            ]
          }
        }
      ]
    }
  },
  "steps": [
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "state_text"
      },
      "text": "first state"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://set_state?state_id=0/sample/second",
        "log_id": "set_second_state"
      }
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "state_text"
      },
      "text": "second state"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://set_state?state_id=0/sample/first",
        "log_id": "return_first_state"
      }
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "state_text"
      },
      "text": "first state"
    }
  ]
}
