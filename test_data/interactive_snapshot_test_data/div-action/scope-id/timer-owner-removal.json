{
  "description": "Removing a timer owner cancels its timer",
  "platforms": [
    "web"
  ],
  "div_data": {
    "card": {
      "log_id": "timer_owner_removal",
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "container",
            "id": "all_scopes",
            "items": [
              {
                "type": "state",
                "id": "removable_state",
                "states": [
                  {
                    "state_id": "shown",
                    "div": {
                      "type": "text",
                      "id": "removable_scope",
                      "text": "Timer owner",
                      "timers": [
                        {
                          "id": "removable_timer",
                          "duration": 100,
                          "end_actions": [
                            {
                              "log_id": "set_removed_timer_finished",
                              "typed": {
                                "type": "set_variable",
                                "variable_name": "removed_timer_finished",
                                "value": {
                                  "type": "boolean",
                                  "value": true
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "state_id": "hidden",
                    "div": {
                      "type": "text",
                      "text": "Owner removed"
                    }
                  }
                ]
              },
              {
                "type": "text",
                "id": "removed_status",
                "text": "Removed timer finished: @{removed_timer_finished}"
              }
            ]
          }
        }
      ],
      "variables": [
        {
          "name": "removed_timer_finished",
          "type": "boolean",
          "value": false
        }
      ]
    }
  },
  "steps": [
    {
      "type": "div_action",
      "action": {
        "log_id": "start_removable_timer_25",
        "scope_id": "removable_scope",
        "typed": {
          "type": "timer",
          "id": "removable_timer",
          "action": "start"
        }
      }
    },
    {
      "type": "div_action",
      "action": {
        "log_id": "remove_timer_owner",
        "typed": {
          "type": "set_state",
          "state_id": "0/removable_state/hidden"
        }
      }
    },
    {
      "type": "wait",
      "duration_ms": 250
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "removed_status"
      },
      "text": "Removed timer finished: false"
    }
  ]
}
