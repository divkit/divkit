{
  "description": "Actions on two items of one item_builder prototype and one item of another resolve each item's data in set_variable URLs and display the selected item's title.",
  "platforms": [
    "android",
    "ios"
  ],
  "div_data": {
    "templates": {
      "exampleCard": {
        "type": "container",
        "border": {
          "corner_radius": 16,
          "stroke": {
            "color": "#aaaaaa",
            "width": 1
          }
        },
        "margins": {
          "bottom": 6
        },
        "orientation": "vertical",
        "paddings": {
          "top": 12,
          "bottom": 12,
          "left": 12,
          "right": 12
        }
      }
    },
    "card": {
      "log_id": "prototypes",
      "variables": [
        {
          "name": "text_variable",
          "type": "string",
          "value": "Text displaying the description of the card."
        },
        {
          "name": "data",
          "type": "array",
          "value": [
            {
              "style": "only_text",
              "title": "First text card",
              "test_id": "first_text_card"
            },
            {
              "style": "only_text",
              "title": "Second text card",
              "test_id": "second_text_card"
            },
            {
              "style": "only_text",
              "title": "Third text card",
              "test_id": "third_text_card"
            },
            {
              "style": "with_image",
              "title": "Card with image",
              "image_url": "https://yastatic.net/s3/home/divkit/chess.png",
              "test_id": "image_card"
            }
          ]
        }
      ],
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "container",
            "items": [
              {
                "type": "exampleCard",
                "items": [
                  {
                    "type": "text",
                    "text": "@{text_variable}",
                    "id": "selected_card_title_text"
                  }
                ]
              },
              {
                "type": "container",
                "orientation": "vertical",
                "item_builder": {
                  "data": "@{data}",
                  "data_element_name": "item",
                  "prototypes": [
                    {
                      "selector": "@{getStringFromDict(item, 'style') == 'only_text'}",
                      "div": {
                        "type": "exampleCard",
                        "actions": [
                          {
                            "log_id": "check",
                            "url": "div-action://set_variable?name=text_variable&value=@{getStringFromDict(item, 'title')}"
                          }
                        ],
                        "items": [
                          {
                            "type": "text",
                            "text": "@{getStringFromDict(item, 'title')}",
                            "width": {
                              "type": "wrap_content"
                            },
                            "font_size": 16,
                            "margins": {
                              "bottom": 4
                            }
                          }
                        ],
                        "width": {
                          "type": "wrap_content"
                        }
                      },
                      "id": "@{getStringFromDict(item, 'test_id')}"
                    },
                    {
                      "selector": "@{getStringFromDict(item, 'style') == 'with_image'}",
                      "div": {
                        "type": "exampleCard",
                        "actions": [
                          {
                            "log_id": "check",
                            "url": "div-action://set_variable?name=text_variable&value=@{getStringFromDict(item, 'title')}"
                          }
                        ],
                        "items": [
                          {
                            "type": "image",
                            "image_url": "@{getStringFromDict(item, 'image_url')}",
                            "width": {
                              "type": "fixed",
                              "value": 50
                            },
                            "height": {
                              "type": "fixed",
                              "value": 50
                            }
                          },
                          {
                            "type": "text",
                            "text": "@{getStringFromDict(item, 'title')}",
                            "width": {
                              "type": "wrap_content"
                            },
                            "alignment_vertical": "center",
                            "font_size": 16,
                            "margins": {
                              "left": 4
                            }
                          }
                        ],
                        "width": {
                          "type": "wrap_content"
                        }
                      },
                      "id": "@{getStringFromDict(item, 'test_id')}"
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  },
  "steps": [
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "selected_card_title_text"
      },
      "text": "Text displaying the description of the card."
    },
    {
      "type": "tap",
      "target": {
        "type": "div_id",
        "id": "first_text_card"
      }
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "selected_card_title_text"
      },
      "text": "First text card"
    },
    {
      "type": "tap",
      "target": {
        "type": "div_id",
        "id": "second_text_card"
      }
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "selected_card_title_text"
      },
      "text": "Second text card"
    },
    {
      "type": "tap",
      "target": {
        "type": "div_id",
        "id": "image_card"
      }
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "selected_card_title_text"
      },
      "text": "Card with image"
    }
  ]
}
