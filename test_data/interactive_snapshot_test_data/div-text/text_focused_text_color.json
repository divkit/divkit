{
  "description": "Focused text color updates with its variable while focus is retained",
  "platforms": ["android", "ios"],
  "div_data": {
    "templates": {
      "button": {
        "type": "text",
        "paddings": {
          "top": 4,
          "bottom": 4,
          "left": 8,
          "right": 8
        },
        "margins": {
          "right": 8,
          "left": 8
        },
        "text_alignment_horizontal": "center",
        "text_alignment_vertical": "center",
        "font_size": 30,
        "text_color": "#ffff",
        "focused_text_color": "@{focused_text_color}",
        "font_weight": "bold",
        "height": {
          "type": "fixed",
          "value": 200
        },
        "width": {
          "type": "fixed",
          "value": 200
        },
        "border": {
          "corner_radius": 16
        },
        "background": [
          {
            "type": "solid",
            "color": "#0000FF"
          }
        ],
        "focus": {
          "background": [
            {
              "type": "solid",
              "color": "#ff5500"
            }
          ]
        },
        "action": {
          "log_id": "button",
          "typed": {
            "type": "focus_element",
            "element_id": "button_for_focus"
          }
        }
      }
    },
    "card": {
      "log_id": "tests",
      "variables": [
        {
          "name": "focused_text_color",
          "type": "color",
          "value": "#00FF00"
        }
      ],
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "container",
            "orientation": "vertical",
            "margins": {
              "top": 24,
              "bottom": 24
            },
            "items": [
              {
                "id": "button_for_focus",
                "type": "button",
                "text": "button for focus"
              }
            ]
          }
        }
      ]
    }
  },
  "steps": [
    {
      "type": "verify_snapshot",
      "name": "step0"
    },
    {
      "type": "div_action",
      "action": {
        "log_id": "focus",
        "typed": {
          "type": "focus_element",
          "element_id": "button_for_focus"
        }
      }
    },
    {
      "type": "verify_snapshot",
      "name": "step1"
    },
    {
      "type": "div_action",
      "action": {
        "log_id": "update_focused_text_color",
        "typed": {
          "type": "set_variable",
          "variable_name": "focused_text_color",
          "value": {
            "type": "color",
            "value": "#FF00FF"
          }
        }
      }
    },
    {
      "type": "verify_snapshot",
      "name": "step2"
    }
  ]
}
