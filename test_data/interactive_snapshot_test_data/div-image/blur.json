{
  "description": "A variable-bound blur filter on a 256x256 DivImage follows radius changes 4 -> 0 -> 30 -> 4 through div_action; snapshots verify removing blur, applying a larger radius and restoring the initial image.",
  "platforms": [
    "android",
    "web",
    "ios"
  ],
  "div_data": {
    "card": {
      "log_id": "tests",
      "variables": [
        {
          "name": "blur",
          "type": "integer",
          "value": 4
        }
      ],
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "image",
            "image_url": "https://yastatic.net/s3/home/divkit/chess.png",
            "filters": [
              {
                "type": "blur",
                "radius": "@{blur}"
              }
            ],
            "width": {
              "type": "fixed",
              "value": 256
            },
            "height": {
              "type": "fixed",
              "value": 256
            }
          }
        }
      ]
    }
  },
  "steps": [
    {
      "type": "verify_snapshot",
      "name": "step0"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://set_variable?name=blur&value=0",
        "log_id": "blur: 0"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "step1"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://set_variable?name=blur&value=30",
        "log_id": "blur: 30"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "step2"
    },
    {
      "type": "div_action",
      "action": {
        "url": "div-action://set_variable?name=blur&value=4",
        "log_id": "blur: 4"
      }
    },
    {
      "type": "verify_snapshot",
      "name": "step0"
    }
  ]
}
