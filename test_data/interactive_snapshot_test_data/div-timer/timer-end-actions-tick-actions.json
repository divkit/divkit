{
  "description": "Timer executes end_actions and tick_actions",
  "platforms": [
    "android",
    "ios",
    "web"
  ],
  "div_data": {
    "card": {
      "log_id": "test_card",
      "variables": [
        {
          "name": "tick_count",
          "type": "integer",
          "value": 0
        },
        {
          "name": "timer_finished",
          "type": "boolean",
          "value": false
        }
      ],
      "timers": [
        {
          "id": "timer1",
          "duration": 1000,
          "tick_interval": 100,
          "end_actions": [
            {
              "log_id": "timer finished",
              "typed": {
                "type": "set_variable",
                "variable_name": "timer_finished",
                "value": {
                  "type": "boolean",
                  "value": true
                }
              }
            }
          ],
          "tick_actions": [
            {
              "url": "div-action://set_variable?name=tick_count&value=@{tick_count + 1}",
              "log_id": "timer tick"
            }
          ]
        }
      ],
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "container",
            "items": [
              {
                "type": "text",
                "id": "timer_status",
                "text": "Timer finished: @{timer_finished}"
              },
              {
                "type": "text",
                "id": "tick_status",
                "text": "Tick count valid: @{tick_count > 1 && tick_count <= 10}"
              }
            ]
          }
        }
      ]
    }
  },
  "steps": [
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "timer_status"
      },
      "text": "Timer finished: false"
    },
    {
      "type": "div_action",
      "action": {
        "log_id": "Start timer",
        "url": "div-action://timer?id=timer1&action=start"
      }
    },
    {
      "type": "wait",
      "duration_ms": 2000
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "timer_status"
      },
      "text": "Timer finished: true"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "tick_status"
      },
      "text": "Tick count valid: true"
    }
  ]
}
