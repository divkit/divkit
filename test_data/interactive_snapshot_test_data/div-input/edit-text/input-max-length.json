{
  "description": "Text input max_length: enforce the character limit and update bound text",
  "platforms": [
    "ios"
  ],
  "div_data": {
    "card": {
      "log_id": "input",
      "variables": [
        {
          "name": "my_edit_text",
          "type": "string",
          "value": "Init text"
        }
      ],
      "states": [
        {
          "state_id": 0,
          "div": {
            "type": "container",
            "width": {
              "type": "match_parent"
            },
            "height": {
              "type": "wrap_content"
            },
            "items": [
              {
                "type": "input",
                "max_length": 10,
                "width": {
                  "type": "match_parent"
                },
                "height": {
                  "type": "wrap_content"
                },
                "margins": {
                  "left": 16,
                  "top": 20,
                  "right": 16,
                  "bottom": 16
                },
                "paddings": {
                  "left": 16,
                  "top": 10,
                  "right": 16,
                  "bottom": 10
                },
                "alpha": 1.0,
                "alignment_horizontal": "center",
                "alignment_vertical": "center",
                "background": [
                  {
                    "type": "solid",
                    "color": "#0e000000"
                  }
                ],
                "border": {
                  "corner_radius": 8
                },
                "font_size": 16,
                "font_weight": "medium",
                "text_color": "#000000",
                "text_variable": "my_edit_text",
                "hint_text": "Hint",
                "hint_color": "#888888",
                "highlight_color": "#e0bae3",
                "line_height": 22,
                "select_all_on_focus": 1,
                "id": "text_input"
              },
              {
                "type": "text",
                "width": {
                  "type": "match_parent"
                },
                "height": {
                  "type": "wrap_content"
                },
                "paddings": {
                  "left": 18,
                  "right": 16,
                  "bottom": 16
                },
                "alpha": 1.0,
                "alignment_horizontal": "center",
                "alignment_vertical": "center",
                "font_size": 16,
                "font_weight": "medium",
                "text_alignment_horizontal": "left",
                "text_alignment_vertical": "center",
                "text_color": "#000000",
                "text": "Text: @{my_edit_text}",
                "ranges": [
                  {
                    "start": 0,
                    "end": 5,
                    "text_color": "#777777"
                  }
                ],
                "id": "text_value"
              },
              {
                "type": "text",
                "width": {
                  "type": "match_parent"
                },
                "height": {
                  "type": "wrap_content"
                },
                "paddings": {
                  "left": 18,
                  "right": 16,
                  "bottom": 16
                },
                "alpha": 1.0,
                "alignment_horizontal": "center",
                "alignment_vertical": "center",
                "font_size": 16,
                "font_weight": "medium",
                "text_alignment_horizontal": "left",
                "text_alignment_vertical": "center",
                "text_color": "#000000",
                "text": "Text len: @{len(my_edit_text)}",
                "ranges": [
                  {
                    "start": 0,
                    "end": 9,
                    "text_color": "#777777"
                  }
                ],
                "id": "text_length"
              }
            ]
          }
        }
      ]
    }
  },
  "steps": [
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "text_value"
      },
      "text": "Text: Init text"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "text_length"
      },
      "text": "Text len: 9"
    },
    {
      "type": "edit_text",
      "target": {
        "type": "div_id",
        "id": "text_input"
      },
      "mode": "append",
      "text": "7"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "text_value"
      },
      "text": "Text: Init text7"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "text_length"
      },
      "text": "Text len: 10"
    },
    {
      "type": "edit_text",
      "target": {
        "type": "div_id",
        "id": "text_input"
      },
      "mode": "append",
      "text": "8"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "text_value"
      },
      "text": "Text: Init text7"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "text_length"
      },
      "text": "Text len: 10"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "text_input"
      },
      "text": "Init text7"
    },
    {
      "type": "edit_text",
      "target": {
        "type": "div_id",
        "id": "text_input"
      },
      "mode": "replace",
      "text": "abc"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "text_value"
      },
      "text": "Text: abc"
    },
    {
      "type": "verify_text",
      "target": {
        "type": "div_id",
        "id": "text_length"
      },
      "text": "Text len: 3"
    }
  ]
}
