{
  "description": "Wrap-content galleries reserve all three lanes when only two items are present.",
  "platforms": [
    "android",
    "ios",
    "web"
  ],
  "templates": {
    "gallery_item": {
      "type": "text",
      "text": "",
      "width": {
        "type": "fixed",
        "value": 40
      },
      "height": {
        "type": "fixed",
        "value": 40
      },
      "background": [
        {
          "type": "solid",
          "color": "#4682B4"
        }
      ]
    },
    "three_lane_gallery": {
      "type": "gallery",
      "column_count": 3,
      "cross_spacing": 8,
      "width": {
