      },
      "height": {
        "type": "wrap_content"
      },
      "background": [
        {
          "type": "solid",
          "color": "#D3D3D3"
        }
      ],
      "items": [
        {
          "type": "gallery_item"
        },
        {
          "type": "gallery_item"
        }
      ]
    }
  },
  "card": {
    "log_id": "snapshot_test_card",
    "states": [
      {
        "state_id": 0,
        "div": {
          "type": "container",
          "orientation": "vertical",
          "item_spacing": 16,
          "width": {
            "type": "wrap_content"
          },
          "items": [
            {
              "type": "three_lane_gallery",
              "orientation": "vertical"
            },
            {
              "type": "three_lane_gallery",
              "orientation": "horizontal"
            }
          ]
        }
      }
    ]
