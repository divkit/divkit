{
  "description": "Range background and border over a font size fragment followed by an inline image, a trailing space and a line feed",
  "platforms": [
    "android",
    "ios",
    "web"
  ],
  "templates": {
    "fragments_text": {
      "type": "text",
      "font_size": 24,
      "margins": {
        "left": 16,
        "top": 8,
        "right": 16,
        "bottom": 8
      }
    }
  },
  "card": {
    "log_id": "snapshot_test_card",
    "states": [
      {
        "state_id": 0,
        "div": {
          "type": "container",
          "background": [
            {
              "type": "solid",
              "color": "#FFFFFF"
            }
          ],
          "items": [
            {
              "type": "fragments_text",
              "text": "Title \nBody",
              "ranges": [
                {
                  "start": 0,
                  "end": 11,
