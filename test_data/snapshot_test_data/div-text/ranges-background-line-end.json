                },
                {
                  "start": 0,
                  "end": 5,
                  "font_size": 14
                }
              ],
              "images": [
                {
                  "start": 5,
                  "url": "https://yastatic.net/s3/home/divkit/chess.png",
                  "width": {
                    "type": "fixed",
                    "value": 12
                  },
                  "height": {
                    "type": "fixed",
