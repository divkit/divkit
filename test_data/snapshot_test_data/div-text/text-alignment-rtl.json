{
  "description": "RTL and LTR text aligned to start/end/left/right/center in RTL layout direction context. Text should be aligned according to the title of the text block.",
  "platforms": [
    "android",
    "ios",
    "web",
    "flutter"
  ],
  "configuration": {
    "layout_direction": "rtl"
  },
  "templates": {
    "text_block": {
      "type": "text",
      "margins": {
        "left": 10,
        "right": 10,
        "top": 5,
        "bottom": 5
      },
      "paddings": {
        "left": 10,
        "right": 10,
        "top": 10,
        "bottom": 10
      },
      "background": [
        {
          "type": "solid",
          "color": "#0e000000"
        }
      ],
      "font_size": 12,
      "font_weight": "medium"
    }
  },
  "card": {
    "log_id": "container",
    "states": [
      {
        "state_id": 0,
        "div": {
          "type": "container",
          "orientation": "vertical",
          "paddings": {
            "top": 5,
            "bottom": 5
          },
          "background": [
            {
              "type": "solid",
              "color": "#FFFFFF"
            }
          ],
          "items": [
            {
              "type": "text_block",
              "text_alignment_horizontal": "start",
              "text": "LTR text aligned to START"
            },
            {
              "type": "text_block",
              "text_alignment_horizontal": "end",
              "text": "LTR text aligned to END"
            },
            {
              "type": "text_block",
              "text_alignment_horizontal": "left",
              "text": "LTR text aligned to LEFT"
            },
            {
              "type": "text_block",
              "text_alignment_horizontal": "right",
              "text": "LTR text aligned to RIGHT"
            },
            {
              "type": "text_block",
              "text_alignment_horizontal": "center",
              "text": "LTR text aligned to CENTER"
            },
            {
              "type": "text_block",
              "text_alignment_horizontal": "start",
              "text": "تمت محاذاة نص RTL إلى START"
            },
            {
              "type": "text_block",
              "text_alignment_horizontal": "end",
              "text": "تمت محاذاة نص RTL إلى END"
            },
            {
              "type": "text_block",
              "text_alignment_horizontal": "left",
              "text": "تمت محاذاة نص RTL إلى LEFT"
            },
            {
              "type": "text_block",
              "text_alignment_horizontal": "right",
              "text": "تمت محاذاة نص RTL إلى RIGHT"
            },
            {
              "type": "text_block",
              "text_alignment_horizontal": "center",
              "text": "تمت محاذاة نص RTL إلى CENTER"
            }
          ]
        }
      }
    ]
  }
}
