{
  "templates": {
    "label": {
      "type": "text",
      "font_size": 16,
      "font_weight": "bold",
      "margins": {
        "left": 16,
        "top": 16,
        "right": 16,
        "bottom": 8
      }
    },
    "password_input": {
      "type": "input",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "margins": {
        "left": 16,
        "right": 16
      },
      "paddings": {
        "left": 16,
        "top": 10,
        "right": 16,
        "bottom": 10
      },
      "background": [
        {
          "type": "solid",
          "color": "#0e000000"
        }
      ],
      "border": {
        "corner_radius": 8
      },
      "font_size": 16,
      "text_color": "#000000",
      "hint_color": "#888888",
      "keyboard_type": "@{is_masked ? 'password' : 'single_line_text'}"
    }
  },
  "card": {
    "log_id": "accessibility_input_password",
    "variables": [
      {
        "name": "password_hint",
        "type": "string",
        "value": ""
      },
      {
        "name": "password_description",
        "type": "string",
        "value": ""
      },
      {
        "name": "password_merged",
        "type": "string",
        "value": "qwerty123"
      },
      {
        "name": "password_validated",
        "type": "string",
        "value": ""
      },
      {
        "name": "is_valid",
        "type": "boolean",
        "value": false
      },
      {
        "name": "is_masked",
        "type": "boolean",
        "value": true
      }
    ],
    "states": [
      {
        "state_id": 0,
        "div": {
          "type": "container",
          "width": {
            "type": "match_parent"
          },
          "height": {
            "type": "wrap_content"
          },
          "items": [
            {
              "type": "label",
              "text": "Password with hint"
            },
            {
              "type": "password_input",
              "text_variable": "password_hint",
              "hint_text": "Password"
            },
            {
              "type": "label",
              "text": "Password with accessibility description"
            },
            {
              "type": "password_input",
              "text_variable": "password_description",
              "hint_text": "Password",
              "accessibility": {
                "description": "Secret code"
              }
            },
            {
              "type": "label",
              "text": "Password inside container with merge mode"
            },
            {
              "type": "container",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "accessibility": {
                "mode": "merge"
              },
              "items": [
                {
                  "type": "text",
                  "text": "Account",
                  "font_size": 16,
                  "margins": {
                    "left": 16,
                    "right": 16,
                    "bottom": 8
                  }
                },
                {
                  "type": "password_input",
                  "text_variable": "password_merged",
                  "hint_text": "Password"
                }
              ]
            },
            {
              "type": "label",
              "text": "Password with validator (at least 6 characters)"
            },
            {
              "type": "password_input",
              "text_variable": "password_validated",
              "hint_text": "Password",
              "validators": [
                {
                  "type": "regex",
                  "pattern": ".{6,}",
                  "variable": "is_valid",
                  "label_id": "validation_error"
                }
              ]
            },
            {
              "type": "text",
              "id": "validation_error",
              "text": "Password is too short",
              "font_size": 14,
              "text_color": "#cc0000",
              "margins": {
                "left": 16,
                "top": 4,
                "right": 16
              },
              "visibility": "@{is_valid ? 'invisible' : 'visible'}"
            },
            {
              "type": "text",
              "text": "Toggle password visibility",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "margins": {
                "left": 16,
                "top": 20,
                "right": 16,
                "bottom": 16
              },
              "paddings": {
                "left": 16,
                "top": 10,
                "right": 16,
                "bottom": 10
              },
              "background": [
                {
                  "type": "solid",
                  "color": "#0e000000"
                }
              ],
              "border": {
                "corner_radius": 8
              },
              "font_size": 16,
              "font_weight": "medium",
              "text_color": "#000000",
              "actions": [
                {
                  "log_id": "toggle",
                  "url": "div-action://set_variable?name=is_masked&value=@{is_masked ? 'false' : 'true'}"
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
