{
  "templates": {
    "button": {
      "type": "text",
      "width": {
        "type": "fixed",
        "value": 160
      },
      "height": {
        "type": "fixed",
        "value": 36
      },
      "font_size": 13,
      "text_alignment_horizontal": "center",
      "text_alignment_vertical": "center",
      "background": [
        {
          "type": "solid",
          "color": "#DDDDDD"
        }
      ],
      "margins": {
        "right": 4,
        "top": 4
      },
      "border": {
        "corner_radius": 4
      }
    },
    "tile": {
      "type": "text",
      "width": {
        "type": "fixed",
        "value": 140
      },
      "height": {
        "type": "fixed",
        "value": 140
      },
      "font_size": 28,
      "text_alignment_horizontal": "center",
      "text_alignment_vertical": "center",
      "background": [
        {
          "type": "solid",
          "$color": "color"
        }
      ]
    },
    "pager_tile": {
      "type": "tile",
      "width": {
        "type": "match_parent"
      }
    },
    "navigation_gallery": {
      "type": "control_row",
      "items": [
        {
          "type": "button",
          "text": "Gallery",
          "actions": [
            {
              "log_id": "duration_mode_0",
              "typed": {
                "type": "set_state",
                "state_id": "0"
              }
            }
          ]
        },
        {
          "type": "button",
          "text": "Vertical",
          "actions": [
            {
              "log_id": "duration_mode_1",
              "typed": {
                "type": "set_state",
                "state_id": "1"
              }
            }
          ]
        }
      ]
    },
    "navigation_pager": {
      "type": "button",
      "text": "Pager",
      "actions": [
        {
          "log_id": "duration_mode_3",
          "typed": {
            "type": "set_state",
            "state_id": "3"
          }
        }
      ]
    },
    "scroll_controls": {
      "type": "control_row",
      "items": [
        {
          "type": "button",
          "text": "First",
          "actions": [
            {
              "log_id": "duration_first",
              "typed": {
                "type": "scroll_to",
                "$id": "target",
                "destination": {
                  "type": "item_id",
                  "$value": "first_item"
                },
                "duration": "@{scroll_duration}"
              }
            }
          ]
        },
        {
          "type": "button",
          "text": "Last",
          "actions": [
            {
              "log_id": "duration_last",
              "typed": {
                "type": "scroll_to",
                "$id": "target",
                "destination": {
                  "type": "item_id",
                  "$value": "last_item"
                },
                "duration": "@{scroll_duration}"
              }
            }
          ]
        }
      ]
    },
    "duration_controls": {
      "type": "control_row",
      "items": [
        {
          "type": "button",
          "text": "0.5с",
          "background": [
            {
              "type": "solid",
              "color": "@{scroll_duration == 500 ? '#81C784' : '#DDDDDD'}"
            }
          ],
          "actions": [
            {
              "log_id": "duration_500",
              "typed": {
                "type": "set_variable",
                "variable_name": "scroll_duration",
                "value": {
                  "type": "integer",
                  "value": 500
                }
              }
            }
          ]
        },
        {
          "type": "button",
          "text": "2с",
          "background": [
            {
              "type": "solid",
              "color": "@{scroll_duration == 2000 ? '#81C784' : '#DDDDDD'}"
            }
          ],
          "actions": [
            {
              "log_id": "duration_2000",
              "typed": {
                "type": "set_variable",
                "variable_name": "scroll_duration",
                "value": {
                  "type": "integer",
                  "value": 2000
                }
              }
            }
          ]
        }
      ]
    },
    "section": {
      "type": "container",
      "orientation": "vertical",
      "paddings": {
        "left": 8,
        "right": 8
      }
    },
    "control_row": {
      "type": "container",
      "orientation": "horizontal"
    }
  },
  "card": {
