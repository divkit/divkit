{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "strictNullChecks": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
